@{
    ViewData["Title"] = "Users Only";
}

<style>

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        min-height: 100vh;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #0f172a, #1e293b, #334155);
        color: #f8fafc;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
    }

    .container {
        width: 100%;
        max-width: 950px;
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(14px);
        border-radius: 24px;
        padding: 35px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.35);
        animation: fadeUp 1s ease;
    }

    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .title {
        font-size: 2.4rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 10px;
        background: linear-gradient(90deg, #60a5fa, #a78bfa, #22d3ee);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .subtitle {
        text-align: center;
        color: #cbd5e1;
        margin-bottom: 30px;
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .card {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 22px;
        transition: all 0.35s ease;
    }

        .card:hover {
            transform: translateY(-6px);
            background: rgba(255,255,255,0.09);
            box-shadow: 0 15px 35px rgba(0,0,0,0.25);
        }

        .card h3 {
            font-size: 1.1rem;
            margin-bottom: 12px;
            color: #93c5fd;
        }

        .card p {
            color: #e2e8f0;
            line-height: 1.6;
        }

    .username {
        font-weight: 700;
        color: #22d3ee;
    }

    .claims-title {
        font-size: 1.5rem;
        margin-bottom: 18px;
        color: #f8fafc;
        text-align: center;
    }

    .claims-list {
        list-style: none;
        display: grid;
        gap: 14px;
    }

        .claims-list li {
            background: rgba(255,255,255,0.06);
            border-left: 5px solid #38bdf8;
            padding: 14px 16px;
            border-radius: 14px;
        }

    .empty-claims {
        text-align: center;
        padding: 20px;
        border-radius: 16px;
        background: rgba(255,255,255,0.05);
        color: #cbd5e1;
    }

    .back-btn {
        margin-top: 30px;
        display: inline-block;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 14px;
        font-weight: 600;
        color: white;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        transition: all 0.3s ease;
    }

        .back-btn:hover {
            transform: scale(1.05);
        }

</style>

<div class="container">

    <h1 class="title">Users Only Area</h1>
    <p class="subtitle">Welcome to the protected section of the application.</p>

    <div class="status-grid">

        <div class="card">
            <h3>🔐 Authentication Status</h3>
            <p>This route is only available to authenticated users.</p>
            <p>Your session is currently verified through secure cookie authentication.</p>
        </div>

        <div class="card">
            <h3>👤 Current User</h3>
            <p>Hello <span class="username">@(User.Identity?.Name ?? "Anonymous")</span> 👋</p>
            <p>You now have access to protected features of the system.</p>
        </div>

        <div class="card">
            <h3>⭐ Available Actions</h3>
            <p>While logged in you can:</p>
            <ul style="margin-top:10px; padding-left:18px;">
                <li>Access protected pages</li>
                <li>View personalized content</li>
                <li>Interact with secure system features</li>
            </ul>
        </div>

    </div>

    <h2 class="claims-title">Your Claims</h2>

    @if (User.Claims.Any())
    {
        <ul class="claims-list">
            @foreach (var claim in User.Claims)
            {
                <li>@claim.Type : @claim.Value</li>
            }
        </ul>
    }
    else
    {
        <p class="empty-claims">No claims found for this user.</p>
    }

    <div style="text-align:center;">
        <a asp-action="Index" asp-controller="Home" class="back-btn">⬅ Back to Home</a>
    </div>

</div>
