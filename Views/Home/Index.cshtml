@{
    ViewData["Title"] = "Cookie Authentication";
}

<!DOCTYPE html>
<html lang="en">

  


<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cookie Authentication</title>


    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f172a, #1e293b, #334155);
            color: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px;
            overflow-x: hidden;
        }

        .background-blur {
            position: fixed;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            filter: blur(100px);
            z-index: 0;
            animation: floatBlob 8s ease-in-out infinite alternate;
        }

        .blob1 {
            top: 5%;
            left: 5%;
            background: rgba(59, 130, 246, 0.35);
        }

        .blob2 {
            bottom: 10%;
            right: 10%;
            background: rgba(168, 85, 247, 0.30);
            animation-delay: 2s;
        }

        @@keyframes floatBlob {
            from {
                transform: translateY(0px) translateX(0px) scale(1);
            }

            to {
                transform: translateY(30px) translateX(20px) scale(1.1);
            }
        }

        .container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 950px;
            background: rgba(15, 23, 42, 0.75);
            border: 1px solid rgba(255,255,255,0.1);
            backdrop-filter: blur(14px);
            border-radius: 24px;
            padding: 35px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
            animation: fadeUp 1s ease;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .title {
            font-size: 2.4rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 10px;
            background: linear-gradient(90deg, #60a5fa, #a78bfa, #22d3ee);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shimmer 4s linear infinite;
            background-size: 200% auto;
        }

        @@keyframes shimmer {
            to {
                background-position: 200% center;
            }
        }

        .subtitle {
            text-align: center;
            color: #cbd5e1;
            margin-bottom: 30px;
            font-size: 1rem;
        }

        .nav-links {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 30px;
        }

            .nav-links a {
                text-decoration: none;
                color: white;
                padding: 12px 22px;
                border-radius: 14px;
                font-weight: 600;
                transition: all 0.35s ease;
                background: linear-gradient(135deg, #2563eb, #7c3aed);
                box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25);
            }

                .nav-links a:hover {
                    transform: translateY(-4px) scale(1.03);
                    box-shadow: 0 15px 30px rgba(124, 58, 237, 0.35);
                }

        .status-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 20px;
            padding: 22px;
            transition: all 0.35s ease;
            animation: floatCard 4s ease-in-out infinite;
        }

            .card:nth-child(2) {
                animation-delay: 1.2s;
            }

            .card:nth-child(3) {
                animation-delay: 2s;
            }

        @@keyframes floatCard {
            0%, 100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        .card:hover {
            transform: translateY(-6px);
            background: rgba(255,255,255,0.09);
            box-shadow: 0 15px 35px rgba(0,0,0,0.25);
        }

        .card h3 {
            font-size: 1.1rem;
            margin-bottom: 12px;
            color: #93c5fd;
        }

        .card p {
            color: #e2e8f0;
            line-height: 1.6;
        }

        .username {
            font-weight: 700;
            color: #22d3ee;
        }

        .auth-yes {
            color: #4ade80;
            font-weight: 700;
        }

        .auth-no {
            color: #f87171;
            font-weight: 700;
        }

        .logout-form {
            margin-top: 12px;
        }

        .logout-btn {
            border: none;
            outline: none;
            padding: 12px 22px;
            border-radius: 14px;
            cursor: pointer;
            font-size: 0.95rem;
            font-weight: 700;
            color: white;
            background: linear-gradient(135deg, #ef4444, #f97316);
            transition: all 0.3s ease;
            box-shadow: 0 10px 25px rgba(239, 68, 68, 0.25);
        }

            .logout-btn:hover {
                transform: scale(1.05);
                box-shadow: 0 15px 30px rgba(249, 115, 22, 0.35);
            }

        .claims-section {
            margin-top: 10px;
        }

        .claims-title {
            font-size: 1.5rem;
            margin-bottom: 18px;
            color: #f8fafc;
            text-align: center;
        }

        .claims-list {
            list-style: none;
            display: grid;
            gap: 14px;
        }

            .claims-list li {
                background: rgba(255,255,255,0.06);
                border-left: 5px solid #38bdf8;
                padding: 14px 16px;
                border-radius: 14px;
                color: #e2e8f0;
                transition: all 0.3s ease;
                opacity: 0;
                transform: translateY(20px);
                animation: revealItem 0.7s ease forwards;
            }

                .claims-list li:hover {
                    transform: translateX(6px);
                    background: rgba(255,255,255,0.10);
                }

                .claims-list li:nth-child(1) {
                    animation-delay: 0.1s;
                }

                .claims-list li:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .claims-list li:nth-child(3) {
                    animation-delay: 0.3s;
                }

                .claims-list li:nth-child(4) {
                    animation-delay: 0.4s;
                }

                .claims-list li:nth-child(5) {
                    animation-delay: 0.5s;
                }

                .claims-list li:nth-child(6) {
                    animation-delay: 0.6s;
                }

        @@keyframes revealItem {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .empty-claims {
            text-align: center;
            padding: 20px;
            border-radius: 16px;
            background: rgba(255,255,255,0.05);
            color: #cbd5e1;
        }

        .icon {
            font-size: 1.2rem;
            margin-right: 8px;
        }

        @@media (max-width: 768px) {
            .container {
                padding: 22px;
            }

            .title {
                font-size: 1.9rem;
            }

            .nav-links {
                flex-direction: column;
            }

                .nav-links a {
                    text-align: center;
                }
        }
    </style>
</head>

<body>
    <div class="background-blur blob1"></div>
    <div class="background-blur blob2"></div>

    <div class="container">
        <h1 class="title">Cookie Authentication in ASP.NET Core MVC</h1>
        <p class="subtitle">A modern authentication dashboard with claims, role access, and animated UI.</p>

        <div class="nav-links">
            <a asp-action="UsersOnly" asp-controller="Home">User's Only Page</a>
            <a asp-action="AdminOnly" asp-controller="Home">Admin's Only Page</a>
        </div>

        <div class="status-grid">
            <div class="card">
                <h3><span class="icon">👤</span>Current User</h3>
                <p>
                    Currently, the user is
                    <span class="username">@(User.Identity?.Name ?? "Anonymous")</span>
                </p>

                <p style="margin-top:10px;">
                    Session username:
                    <span class="username">@(ViewBag.UserName ?? "No session data")</span>
                </p>

            </div>

            <div class="card">
                <h3><span class="icon">🔐</span>Authentication Status</h3>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <p>They are <span class="auth-yes">authenticated</span>.</p>
                }
                else
                {
                    <p>They are <span class="auth-no">not authenticated</span>.</p>
                }
            </div>

            <div class="card">
                <h3><span class="icon">🚪</span>Session Action</h3>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <p>You can securely end the current session below.</p>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form">
                        <button type="submit" class="logout-btn">Logout</button>
                    </form>
                }
                else
                {
                    <p>No active session found at the moment.</p>
                }
            </div>
        </div>

        <div class="claims-section">
            <h2 class="claims-title">Claims</h2>

            @if (User.Claims.Any())
            {
                <ul class="claims-list">
                    @foreach (var claim in User.Claims)
                    {
                        <li>@claim.ToString()</li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-claims">
                    <p>No Claims found</p>
                </div>
            }
        </div>
    </div>
</body>
</html>
