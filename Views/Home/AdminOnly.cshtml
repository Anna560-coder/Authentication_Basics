@{
    ViewData["Title"] = "Admin Only";
}

<style>

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        min-height: 100vh;
        font-family: "Segoe UI",Tahoma,Geneva,Verdana,sans-serif;
        background: linear-gradient(135deg,#0f172a,#1e293b,#334155);
        color: #f8fafc;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
    }

    .container {
        width: 100%;
        max-width: 950px;
        background: rgba(15,23,42,0.75);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(14px);
        border-radius: 24px;
        padding: 35px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.35);
        animation: fadeUp 1s ease;
    }

    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .title {
        font-size: 2.4rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 10px;
        background: linear-gradient(90deg,#60a5fa,#a78bfa,#22d3ee);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .subtitle {
        text-align: center;
        color: #cbd5e1;
        margin-bottom: 30px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(260px,1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .card {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 22px;
        transition: all 0.35s ease;
    }

        .card:hover {
            transform: translateY(-6px);
            background: rgba(255,255,255,0.09);
            box-shadow: 0 15px 35px rgba(0,0,0,0.25);
        }

        .card h3 {
            margin-bottom: 12px;
            color: #93c5fd;
        }

        .card p {
            color: #e2e8f0;
            line-height: 1.6;
        }

    .admin-badge {
        display: inline-block;
        margin-top: 10px;
        padding: 6px 14px;
        border-radius: 20px;
        background: linear-gradient(135deg,#ef4444,#f97316);
        font-size: 0.8rem;
        font-weight: 600;
    }

    .username {
        font-weight: 700;
        color: #22d3ee;
    }

    .back-btn {
        margin-top: 30px;
        display: inline-block;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 14px;
        font-weight: 600;
        color: white;
        background: linear-gradient(135deg,#2563eb,#7c3aed);
        transition: all 0.3s ease;
    }

        .back-btn:hover {
            transform: scale(1.05);
        }

    .center {
        text-align: center;
    }

</style>


<div class="container">

    <h1 class="title">Administrator Control Panel</h1>
    <p class="subtitle">This section is restricted to users with administrative privileges.</p>

    <div class="grid">

        <div class="card">
            <h3>🛡️ Access Level</h3>
            <p>This page is only accessible to users who have the <strong>Admin claim</strong> assigned to their account.</p>
            <span class="admin-badge">Administrator Access</span>
        </div>

        <div class="card">
            <h3>👤 Current User</h3>
            <p>Welcome back <span class="username">@(User.Identity?.Name ?? "Administrator")</span>.</p>
            <p>You are viewing a protected administrative section of the application.</p>
        </div>

        <div class="card">
            <h3>⚙️ Administrative Responsibilities</h3>
            <p>Administrators typically manage system-level features such as:</p>
            <ul style="margin-top:10px; padding-left:18px; line-height:1.8;">
                <li>User role management</li>
                <li>Security configuration</li>
                <li>Application monitoring</li>
                <li>System administration tools</li>
            </ul>
        </div>

    </div>

    <div class="center">
        <a asp-action="Index" asp-controller="Home" class="back-btn">⬅ Return to Home</a>
    </div>

</div>
